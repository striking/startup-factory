# ===========================================
# HAL Assistant - Environment Configuration
# ===========================================

# ---------------------
# Database Configuration
# ---------------------
# Development database (local PostgreSQL)
DATABASE_URL=postgresql://localhost/hal_dev
TEST_DATABASE_URL=postgresql://localhost/hal_test

# Production database (PostgreSQL with SSL recommended)
# DATABASE_URL=postgresql://user:password@host:5432/hal_prod?ssl=true

# Database pool size (number of connections)
POOL_SIZE=10

# Enable IPv6 for Ecto (set to true or 1 if needed)
# ECTO_IPV6=false

# ---------------------
# Phoenix Configuration
# ---------------------
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=generate_with_mix_phx_gen_secret

# Public hostname (for production deployment)
PHX_HOST=localhost

# HTTP port
PORT=4000

# Enable Phoenix server (required for production releases)
PHX_SERVER=true

# Environment (dev, test, prod)
MIX_ENV=dev

# DNS cluster query for distributed Elixir (optional)
# DNS_CLUSTER_QUERY=hal.example.com

# ---------------------
# Messaging Platform Tokens
# ---------------------

# Telegram Bot
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Slack Bot (Socket Mode)
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...)
# SLACK_APP_TOKEN: App-Level Token (xapp-...) for Socket Mode
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here

# Discord Bot
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ---------------------
# AI Provider API Keys
# ---------------------

# Primary AI Provider (Claude Code CLI - OAuth authentication)
# HAL uses your Claude Code subscription via OAuth tokens.
#
# Setup:
#   1. Install Claude Code CLI: npm install -g @anthropics/claude-code
#   2. Authenticate: claude auth login
#   3. Start HAL: mix phx.server
#
# No API key needed! HAL reads OAuth token from ~/.claude/.credentials.json
#
# Optional: Use Anthropic API key for production (instead of CLI)
# ANTHROPIC_API_KEY=sk-ant-... (requires separate API subscription)

# Google Gemini API
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI API (GPT-4, GPT-3.5-turbo)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# AI Routing Configuration
# Enable intelligent provider selection based on task type
AI_ROUTING_ENABLED=true

# ---------------------
# Agent Delegation (Multi-Agent Architecture)
# ---------------------

# Google Jules - Async background coding agent
# Get from: https://jules.google/ (Settings page, max 3 keys)
JULES_API_KEY=your_jules_api_key_here

# Codex CLI - Uses OAuth (run `codex login` to authenticate)
# No API key needed - uses OAuth tokens from ChatGPT login

# Gemini CLI - Uses gcloud auth OR GEMINI_API_KEY above
# Run `gemini` to authenticate via gcloud, or use API key

# ---------------------
# Voice Services (Optional)
# ---------------------

# ElevenLabs TTS (Text-to-Speech)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default: Rachel voice

# OpenAI Whisper STT (Speech-to-Text)
# Uses OPENAI_API_KEY from above

# Alternative: AssemblyAI for STT
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ---------------------
# Gmail Integration (OAuth 2.0)
# ---------------------
# Get from: https://console.cloud.google.com/
# 1. Create project
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:4000/auth/gmail/callback
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:4000/auth/gmail/callback

# TODO: Token storage and refresh mechanism not yet implemented
# Tokens are currently passed directly to integration functions

# ---------------------
# Background Job Configuration (Oban)
# ---------------------
# Format: queue_name:concurrency,queue_name:concurrency
# default: General background jobs
# scheduled: Scheduled tasks (lower concurrency)
# webhooks: External webhook calls
OBAN_QUEUES=default:10,scheduled:5,webhooks:3

# ---------------------
# Logging & Monitoring
# ---------------------
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Telemetry and metrics (optional)
# TELEMETRY_ENABLED=true

# ---------------------
# Release Configuration (Production)
# ---------------------
# Release name (for Elixir releases)
RELEASE_NAME=hal

# Release cookie (for distributed Elixir - generate unique value)
# RELEASE_COOKIE=generate_unique_cookie_here

# Node name (for distributed Elixir)
# RELEASE_NODE=hal@127.0.0.1
