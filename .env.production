# HAL Production Environment Template
# Copy this file to ~/.hal.env and fill in your values
#
# IMPORTANT: Never commit real credentials to version control!

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost/hal_prod

# Connection pool size (adjust based on available memory)
POOL_SIZE=10

# Enable IPv6 for database connections (set to "true" if needed)
ECTO_IPV6=false

# =============================================================================
# PHOENIX
# =============================================================================
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=GENERATE_A_SECURE_SECRET_KEY_WITH_MIX_PHX_GEN_SECRET

# Host for generating URLs
PHX_HOST=localhost

# HTTP port
PORT=4000

# Enable the Phoenix server
PHX_SERVER=true

# =============================================================================
# MESSAGING PLATFORMS
# =============================================================================
# Telegram Bot Token
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Slack Bot Token (xoxb-...)
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=

# Slack App Token (xapp-...) for Socket Mode
SLACK_APP_TOKEN=

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# =============================================================================
# AI PROVIDERS
# =============================================================================
# Note: Claude Code uses local authentication via 'claude auth login'
# No API key needed for Claude Code CLI

# Google AI (Gemini) API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI API Key (for Whisper STT and Codex)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model for fallback/Codex
OPENAI_MODEL=gpt-4

# Enable intelligent AI routing (true/false)
AI_ROUTING_ENABLED=true

# =============================================================================
# AGENT DELEGATION
# =============================================================================
# Google Jules - Async background coding agent
# Get from: https://jules.google/ (Settings page)
JULES_API_KEY=

# Codex CLI - Uses OAuth (run `codex login` to authenticate)
# No API key needed

# Gemini CLI - Can use gcloud auth OR GOOGLE_AI_API_KEY above
# Run `gemini` to authenticate via gcloud

# =============================================================================
# VOICE SERVICES (Optional)
# =============================================================================
# ElevenLabs API Key for Text-to-Speech
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# =============================================================================
# OBAN JOB QUEUE
# =============================================================================
# Queue configuration: name:concurrency,name:concurrency
OBAN_QUEUES=default:10,scheduled:5,webhooks:3

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# DNS cluster query for distributed deployment
# DNS_CLUSTER_QUERY=hal.internal

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# =============================================================================
# NOTES
# =============================================================================
#
# 1. After editing, copy this file to ~/.hal.env:
#    cp .env.production ~/.hal.env
#
# 2. Generate a secret key:
#    mix phx.gen.secret
#
# 3. Ensure Claude Code is authenticated:
#    claude auth login
#
# 4. Create the production database:
#    createdb hal_prod
#
# 5. Run the deployment script:
#    ./scripts/deploy.sh
#
