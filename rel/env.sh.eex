#!/bin/sh
# HAL Release Environment Configuration
# This file is evaluated at runtime before the release starts

# Set default values for critical environment variables
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-hal@127.0.0.1}"

# Path to Claude Code CLI (ensure it's in PATH for the release)
export PATH="${HOME}/.local/bin:${HOME}/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"

# Set HOME for Claude Code CLI authentication
export HOME="${HOME:-/Users/$(whoami)}"

# ERL_AFLAGS for improved memory and scheduler management
export ERL_AFLAGS="-kernel shell_history enabled"

# Ensure UTF-8 encoding
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# Load environment from .env file if it exists
if [ -f "${RELEASE_ROOT}/.env" ]; then
    set -a
    . "${RELEASE_ROOT}/.env"
    set +a
fi

# Also check for .env in common locations
if [ -f "${HOME}/.hal.env" ]; then
    set -a
    . "${HOME}/.hal.env"
    set +a
fi

# Ensure PHX_SERVER is set for production
export PHX_SERVER="${PHX_SERVER:-true}"

# Default port if not set
export PORT="${PORT:-4000}"

# Log configuration
export RELEASE_TMP="${RELEASE_TMP:-/tmp/hal}"
mkdir -p "${RELEASE_TMP}"
